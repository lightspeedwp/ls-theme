        "custom": {
            "layout": {
                "break-points": {
                    "full": "1440px",
                    "desktop": "1280px",
                    "tablet-landscape": "1024px",
                    "tablet-portrait": "768px",
                    "mobile-landscape": "640px",
                    "mobile-portrait": "390px",
                    "mobile-compact": "320px"
                }
            },
            "color": {
                "text": {
                    "default": "var:preset|color|contrast",
                    "inverse": "var:preset|color|base",
                    "muted": "var:preset|color|neutral-700",
                    "subtle": "var:preset|color|neutral-600",
                    "brand": "var:preset|color|brand-500",
                    "brand-strong": "var:preset|color|brand-800",
                    "on-dark": "var:preset|color|base",
                    "on-dark-muted": "var:preset|color|neutral-400"
                },
                "surface": {
                    "canvas": "var:preset|color|base",
                    "card": "var:preset|color|neutral-100",
                    "card-raised": "var:preset|color|neutral-200",
                    "highlight": "var:preset|color|base",
                    "brand-light": "var:preset|color|brand-100",
                    "brand": "var:preset|color|brand-500",
                    "cta-light": "var:preset|color|cta-100",
                    "cta": "var:preset|color|cta-500",
                    "accent-light": "var:preset|color|accent-100",
                    "accent-two-light": "var:preset|color|accent-two-100",
                    "accent-three-light": "var:preset|color|accent-three-100",
                    "band-start": "var:preset|color|surface-700",
                    "band-end": "var:preset|color|surface-300",
                    "on-dark-card": "var:preset|color|surface-200"
                },
                "border": {
                    "card": "var:preset|color|neutral-300"
                },
                "icon": {
                    "background": "var:preset|color|brand-500",
                    "color": "var:preset|color|base",
                    "commerce": "var:preset|color|warning-foreground"
                },
                "card": {
                    "solutions": {
                        "brand": "var:preset|color|brand-500",
                        "accent": "var:preset|color|accent-500"
                    },
                    "platform": {
                        "wordpress": "var:preset|color|brand-500",
                        "woocommerce": "var:preset|color|cta-800"
                    }
                },
                "phase": {
                    "discover": "var:preset|color|phase-one-strong",
                    "create": "var:preset|color|phase-two-strong",
                    "build": "var:preset|color|phase-three-strong",
                    "launch": "var:preset|color|phase-four-strong",
                    "grow": "var:preset|color|phase-five-strong",
                    "evolve": "var:preset|color|phase-six-strong"
                },
                "status": {
                    "success": "var:preset|color|success-foreground"
                },
                "text-shadow": {
                    "contrast": "var:preset|color|contrast",
                    "base": "var:preset|color|base"
                },
                "link": {
                    "default": "var:preset|color|contrast",
                    "decoration-start": "var:preset|color|brand-600",
                    "decoration-end": "var:preset|color|accent-700",
                    "accent": "var:preset|color|brand-500",
                    "accent-hover": "var:preset|color|brand-700"
                },
				"button": {
					"fill": {
						"background": "var:preset|color|brand-500",
						"text": "var:preset|color|base",
						"border": "var:preset|color|brand-500",
						"background-hover": "var:preset|color|brand-500",
						"text-hover": "var:preset|color|contrast",
						"border-hover": "var:preset|color|brand-500"
					},
					"outline": {
						"background": "var:preset|color|surface-400",
						"text": "var:preset|color|brand-500",
						"border": "var:preset|color|brand-500",
						"background-hover": "var:preset|color|brand-500",
						"text-hover": "var:preset|color|base"
					}
				},
                "focus": {
                    "ring": "var:preset|color|contrast"
                },
                "effect": {
                    "spotlight": {
                        "primary": "var:preset|color|brand-500",
                        "secondary": "var:preset|color|cta-500"
                    },
                    "hero": {
                        "brand": "var:preset|color|brand-500",
                        "cta": "var:preset|color|cta-500",
                        "accent": "var:preset|color|accent-two-500"
                    }
                }
            },
            "typography": {
                "letter-spacing": {
                    "tighter": "-0.05em",
                    "tight": "-0.025em",
                    "normal": "0",
                    "wide": "0.025em",
                    "wider": "0.05em",
                    "widest": "0.1em"
                },
                "font-weight": {
                    "thin": "100",
                    "extralight": "200",
                    "light": "300",
                    "normal": "400",
                    "medium": "500",
                    "semibold": "600",
                    "bold": "700",
                    "extrabold": "800",
                    "black": "900"
                }
            },
            "spacing": {
                "button": {
                    "padding-top": "1rem",
                    "padding-right": "4rem",
                    "padding-bottom": "1rem",
                    "padding-left": "1.5rem"
                }
            },
            "shadow": {
                "elevation": {
                    "100": "0.5px 2px 3px 0.5px rgba(17, 17, 17, 0.2)",
                    "200": "0.5px 2px 6px 1px rgba(17, 17, 17, 0.2)",
                    "300": "1px 4px 12px 4px rgba(17, 17, 17, 0.2)",
                    "400": "1px 4px 12px 4px rgba(17, 17, 17, 0.3)",
                    "500": "1px 4px 12px 4px rgba(17, 17, 17, 0.4)",
                    "600": "2px 6px 12px 6px rgba(17, 17, 17, 0.3)"
                },
                "heading": {
                    "contrast": "0.5px 2px 3px color-mix(in srgb, var(--wp--custom--color--text-shadow--contrast) 18%, transparent)",
                    "base": "0.5px 2px 3px color-mix(in srgb, var(--wp--custom--color--text-shadow--base) 24%, transparent)"
                },
                "interactive": {
                    "accent": "1px 4px 12px 4px color-mix(in srgb, var(--wp--custom--color--link--accent) 50%, transparent)"
                },
                "card": {
                    "hover": "0 9px 28px -16px color-mix(in srgb, var(--wp--custom--color--text--brand) 80%, transparent), 0 8px 18px -14px color-mix(in srgb, var(--wp--custom--color--text--brand-strong) 24%, transparent)"
                },
                "popover": {
                    "menu": "0 32px 80px 0 color-mix(in srgb, var(--wp--custom--color--effect--spotlight--primary) 18%, transparent), var(--wp--custom--shadow--elevation--200)"
                },
                "footer": {
                    "notes": "0 0 0 1px color-mix(in srgb, var(--wp--custom--color--phase--create) 14%, transparent), 0 0 24px 0 color-mix(in srgb, var(--wp--custom--color--phase--create) 10%, transparent)"
                }
            },
            "animation": {
                "duration": {
                    "responsive": "160ms",
                    "fast": "180ms",
                    "focus": "200ms",
                    "base": "220ms",
                    "reveal": "240ms",
                    "medium": "280ms",
                    "slow": "350ms",
                    "emphasised": "500ms",
                    "dramatic": "900ms",
                    "loop": "6s"
                },
                "delay": {
                    "none": "0s",
                    "enter": "80ms"
                },
                "easing": {
                    "standard": "ease",
                    "smooth": "ease-in-out",
                    "emphasised": "cubic-bezier(0.4, 0, 0.2, 1)",
                    "dramatic": "cubic-bezier(0.19, 1, 0.22, 1)"
                },
                "runtime": {
                    "easing": {
                        "standard": "power2.out",
                        "emphasised": "power3.out"
                    }
                },
                "scale": {
                    "active": "0.98"
                }
            },
            "z-index": {
                "behind": "-1",
                "base": "0",
                "content": "1",
                "overlay": "10"
            }
        }
    },
    "styles": {
        "color": {
            "background": "var:custom|color|surface|canvas",
            "text": "var:custom|color|text|default"
        }
    },
    "templateParts": [
