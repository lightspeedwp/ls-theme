# Copy to .env (gitignored) in the theme root before running the Playwright tests.

# The site the tests run against, e.g. your local Studio site or the DEV site.
# Tests can only see code that site is serving.
BASE_URL=http://localhost:8882

# Optional: only needed for the standing suite's BugHerd reporter. Leave unset to skip.
# Runs with SINGLE_PAGE_URL set never create BugHerd tasks, whatever is set here.
BUGHERD_API_KEY=
BUGHERD_PROJECT_ID=
