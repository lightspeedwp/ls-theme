{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Feature Card",
	"slug": "feature-card",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact card shell for a replaceable icon, H3 heading, supporting copy, and inline CTA.",
	"styles": {
		"color": {
			"background": "var(--wp--custom--color--surface--card)",
			"text": "var(--wp--custom--color--text--default)"
		},
		"border": {
			"color": "var(--wp--custom--color--border--card)",
			"radius": "var:preset|border-radius|300",
			"style": "solid",
			"width": "1px"
		},
		"shadow": "var(--wp--custom--shadow--elevation--100)",
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"top": "var:preset|spacing|30",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30",
				"left": "var:preset|spacing|30"
			}
		},
		"css": "&{--ls-feature-card-hover-shadow:var(--wp--custom--shadow--card--hover);--ls-feature-card-lift:-4px;}"
	}
}