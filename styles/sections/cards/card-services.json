{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Services",
	"slug": "card-services",
	"blockTypes": [
		"core/group"
	],
	"description": "Centred services card shell with a reusable animated accent border, replaceable icon well, tick list, and inline CTA.",
	"styles": {
		"color": {
			"background": "var(--wp--custom--color--surface--card)",
			"text": "var(--wp--custom--color--text--default)"
		},
		"border": {
			"color": "var(--wp--custom--color--border--card)",
			"radius": "var:preset|border-radius|300",
			"style": "solid",
			"width": "1px"
		},
		"shadow": "var(--wp--custom--shadow--elevation--100)",
		"spacing": {
			"blockGap": "var:preset|spacing|20",
			"padding": {
				"top": "var:preset|spacing|40",
				"right": "var:preset|spacing|40",
				"bottom": "var:preset|spacing|40",
				"left": "var:preset|spacing|40"
			}
		},
		"css": "&{max-inline-size:24.167rem;--ls-card-services-shadow-active:var(--wp--custom--shadow--card--hover);--ls-card-services-scale:1.05;--ls-card-services-accent-thickness:8px;--ls-link-arrow-offset:0;--ls-accent-gradient-image:linear-gradient(90deg,var(--wp--custom--color--effect--spotlight--secondary) 0%,var(--wp--custom--color--effect--spotlight--primary) 50%,var(--wp--custom--color--effect--spotlight--secondary) 100%);--ls-accent-gradient-size:200% auto;--ls-accent-gradient-start-position:0%;--ls-accent-gradient-end-position:100%;--ls-accent-gradient-duration:var(--wp--custom--animation--duration--loop);--ls-accent-gradient-delay:var(--wp--custom--animation--delay--none);--ls-accent-gradient-timing:var(--wp--custom--animation--easing--smooth);--ls-accent-gradient-direction:alternate;--ls-accent-gradient-reduced-position:100%;}"
	}
}