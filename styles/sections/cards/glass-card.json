{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Glass Card",
	"slug": "glass-card",
	"blockTypes": [
		"core/group"
	],
	"description": "Reusable frosted-glass surface for content groups with subtle lift and focus treatment. Shared interaction contract lives in src/scss/animations.scss.",
	"styles": {
		"border": {
			"radius": "var:preset|border-radius|300",
			"style": "solid",
			"width": "1px"
		},
		"color": {
			"text": "var:custom|color|text|default"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"top": "var:preset|spacing|30",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30",
				"left": "var:preset|spacing|30"
			}
		}
	}
}