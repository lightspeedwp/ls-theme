{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Solutions",
	"slug": "card-solutions",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact white card shell for a replaceable icon, supporting copy, and an icon-only CTA.",
	"styles": {
		"color": {
			"background": "var(--wp--custom--color--surface--card)",
			"text": "var(--wp--custom--color--text--default)"
		},
		"border": {
			"color": "var(--wp--custom--color--border--card)",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"shadow": "var(--wp--custom--shadow--elevation--100)",
		"spacing": {
			"blockGap": "var:preset|spacing|10",
			"padding": {
				"top": "var:preset|spacing|30",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30",
				"left": "var:preset|spacing|30"
			}
		},
		"css": "&{--ls-card-solutions-hover-shadow:var(--wp--custom--shadow--interactive--accent);}"
	}
}