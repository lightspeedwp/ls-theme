{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Performance Stat",
	"slug": "card-performance-stat",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact metric card with a left accent rail, reusable tinted icon frame, and left-aligned stat copy.",
	"styles": {
		"color": {
			"background": "var:custom|color|surface|card",
			"text": "var:custom|color|text|default"
		},
		"border": {
			"color": "var:custom|color|border|card",
			"radius": "var:preset|border-radius|100",
			"style": "solid",
			"width": "1px"
		},
		"shadow": "var:preset|shadow|100",
		"spacing": {
			"blockGap": "var:preset|spacing|10",
			"padding": {
				"top": "var:preset|spacing|20",
				"right": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20",
				"left": "var:preset|spacing|20"
			}
		},
		"blocks": {
			"core/heading": {
				"color": {
					"text": "var:custom|color|text|brand"
				},
				"typography": {
					"fontWeight": "var:custom|typography|font-weight|bold",
					"lineHeight": "var:custom|line-height|heading-default"
				}
			},
			"core/paragraph": {
				"color": {
					"text": "var:custom|color|text|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|200",
					"fontWeight": "var:custom|typography|font-weight|normal",
					"lineHeight": "var:custom|line-height|paragraph",
					"letterSpacing": "0.01em"
				}
			}
		},
		"css": "&{--ls-card-performance-stat-shift:4px;--ls-card-performance-stat-accent-thickness:3px;--ls-accent-gradient-image:linear-gradient(180deg,var(--wp--custom--color--effect--spotlight--secondary) 0%,var(--wp--custom--color--effect--spotlight--primary) 50%,var(--wp--custom--color--effect--spotlight--secondary) 100%);}"
	}
}
