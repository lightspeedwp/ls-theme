{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Feature",
	"slug": "card-feature",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact card shell for a replaceable icon, H3 heading, supporting copy, and inline CTA.",
	"styles": {
		"color": {
			"background": "var:custom|color|surface|card",
			"text": "var:custom|color|text|default"
		},
		"border": {
			"color": "var:custom|color|border|card",
			"radius": "var:preset|border-radius|300",
			"style": "solid",
			"width": "1px"
		},
		"shadow": "var:preset|shadow|100",
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"top": "var:preset|spacing|30",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30",
				"left": "var:preset|spacing|30"
			}
		},
		"css": "&{--ls-card-feature-shadow-active:var(--wp--custom--shadow--card--hover);--ls-card-feature-lift:-4px;}"
	}
}