{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Work Project Chip",
	"slug": "card-work-project-chip",
	"blockTypes": [
		"core/group"
	],
	"description": "Floating translucent chip shell for the Work Project Card's platform/industry label, sitting on top of the banner tint.",
	"styles": {
		"border": {
			"color": "var:custom|color|border|card",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|10",
				"right": "var:preset|spacing|10",
				"bottom": "var:preset|spacing|10",
				"left": "var:preset|spacing|10"
			}
		},
		"css": "&{background-color:color-mix(in srgb, var(--wp--custom--color--surface--canvas) 85%, transparent);}"
	}
}
