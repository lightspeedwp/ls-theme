{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Work Category",
	"slug": "card-work-category",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact card shell for the Work archive's category row: tinted icon well, H3 heading, supporting copy, and inline CTA sitting close to the copy (no bottom-anchored CTA, unlike Card - Feature).",
	"styles": {
		"color": {
			"background": "var:custom|color|surface|card",
			"text": "var:custom|color|text|default"
		},
		"border": {
			"color": "var:custom|color|border|card",
			"radius": "var:preset|border-radius|300",
			"style": "solid",
			"width": "1px"
		},
		"shadow": "var:preset|shadow|100",
		"spacing": {
			"blockGap": "var:preset|spacing|20",
			"padding": {
				"top": "var:preset|spacing|20",
				"right": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20",
				"left": "var:preset|spacing|20"
			}
		}
	}
}
