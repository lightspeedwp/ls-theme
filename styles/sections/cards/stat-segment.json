{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Stat Segment",
	"slug": "stat-segment",
	"blockTypes": [
		"core/group"
	],
	"description": "Stat segment for the Work archive engagement row: transparent background with a translucent trailing divider border.",
	"styles": {
		"color": {
			"text": "var:custom|color|text|muted"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|10",
			"padding": {
				"top": "var:preset|spacing|40",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|40",
				"left": "var:preset|spacing|30"
			}
		},
		"css": "&{border-inline-end:1px solid var(--wp--custom--color--border--card);}"
	}
}
