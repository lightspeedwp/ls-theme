{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Hero Stats",
	"slug": "card-hero-stats",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact centred stats card shell for a gradient stat heading and uppercase supporting label.",
	"styles": {
		"color": {
			"background": "var:custom|color|surface|card",
			"text": "var:custom|color|text|default"
		},
		"border": {
			"color": "var:custom|color|border|card",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|5",
			"padding": {
				"top": "var:preset|spacing|20",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|20",
				"left": "var:preset|spacing|30"
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontWeight": "var:custom|typography|font-weight|bold",
					"lineHeight": "var:custom|line-height|heading-default",
					"textTransform": "uppercase"
				}
			},
			"core/paragraph": {
				"color": {
					"text": "var:custom|color|text|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|200",
					"fontWeight": "var:custom|typography|font-weight|medium",
					"lineHeight": "var:custom|line-height|paragraph",
					"letterSpacing": "0.125em",
					"textTransform": "uppercase"
				}
			}
		},
		"css": "&{--ls-card-hero-stats-min-inline-size:11.25rem;--ls-accent-gradient-width:fit-content;--ls-accent-gradient-image:linear-gradient(115deg,var(--wp--custom--color--surface--brand) 0%,var(--wp--custom--color--surface--brand) 35%,var(--wp--custom--color--surface--cta) 65%,var(--wp--custom--color--surface--brand) 100%);}"
	}
}
