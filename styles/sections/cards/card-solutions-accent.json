{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Solutions Accent",
	"slug": "card-solutions-accent",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact solutions card shell with the alternate accent colour treatment.",
	"styles": {
		"color": {
			"background": "var:custom|color|surface|card",
			"text": "var:custom|color|text|default"
		},
		"border": {
			"color": "var:custom|color|border|card",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontSize": "var:preset|font-size|400",
					"lineHeight": "var:custom|line-height|heading-default"
				}
			}
		},
		"shadow": "var:preset|shadow|100",
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"top": "var:preset|spacing|30",
				"right": "var:preset|spacing|30",
				"bottom": "var:preset|spacing|30",
				"left": "var:preset|spacing|30"
			}
		},
		"css": "&{--ls-card-solutions-accent-colour:var(--wp--custom--color--card--solutions--accent);}"
	}
}