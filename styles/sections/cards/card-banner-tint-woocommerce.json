{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card - Banner Tint (WooCommerce)",
	"slug": "card-banner-tint-woocommerce",
	"blockTypes": [
		"core/group"
	],
	"description": "WooCommerce-tinted banner zone for the Work Project Card, applied when the post's project-group term is WooCommerce.",
	"styles": {
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|40",
				"right": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|40",
				"left": "var:preset|spacing|20"
			}
		},
		"css": "&{background-color:color-mix(in srgb, var(--wp--custom--color--card--platform--woocommerce) 7%, transparent);}"
	}
}
