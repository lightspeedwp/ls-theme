{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Page Section - CTA Light",
	"slug": "page-section-cta-light",
	"blockTypes": [
		"core/group"
	],
	"description": "Reusable page section shell with the CTA-tinted light surface and matching strong foreground text.",
	"styles": {
		"color": {
			"background": "var:custom|color|surface|cta-light",
			"text": "var:custom|color|text|cta-strong"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|60",
			"padding": {
				"top": "var:preset|spacing|80",
				"bottom": "var:preset|spacing|80"
			}
		}
	}
}
