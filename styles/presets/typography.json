{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "writingMode": true,
            "fontFamilies": [
                {
                    "name": "Lexend",
                    "slug": "heading",
                    "fontFamily": "Lexend, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Lexend",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "fontWeight": "200",
                            "src": [
                                "file:./assets/fonts/lexend/Lexend-200-normal.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Lexend",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "fontWeight": "300",
                            "src": [
