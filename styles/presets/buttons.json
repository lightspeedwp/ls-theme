{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "elements": {
            "button": {
                "color": {
                    "text": "var:custom|color|button|fill|text"
                },
                "border": {
                    "radius": "var:preset|border-radius|200"
                },
                "spacing": {
                    "padding": {
                        "top": "var:custom|spacing|button|padding-top",
                        "right": "var:custom|spacing|button|padding-right",
                        "bottom": "var:custom|spacing|button|padding-bottom",
                        "left": "var:custom|spacing|button|padding-left"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|200",
                    "fontWeight": "var:custom|typography|font-weight|bold",
                    "letterSpacing": "0.08em"
                }
            }
        }
    }
}
