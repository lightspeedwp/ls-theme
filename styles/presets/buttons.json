{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "custom": {
            "button-padding": {
                "top": "1rem",
                "right": "4rem",
                "bottom": "1rem",
                "left": "1.5rem"
            }
        }
    },
    "styles": {
        "elements": {
            "button": {
                "color": {
                    "text": "var(--wp--custom--color--button--fill--text)"
                },
                "border": {
                    "radius": "var:preset|border-radius|200"
                },
                "spacing": {
                    "padding": {
                        "top": "1rem",
                        "right": "4rem",
                        "bottom": "1rem",
                        "left": "1.5rem"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|200",
                    "fontWeight": "700",
                    "letterSpacing": "0.08em"
                },
                "css": "&{--ls-button-fill-background:var(--wp--custom--color--button--fill--background);--ls-button-fill-icon-colour:var(--wp--custom--color--button--fill--text);--ls-button-fill-hover-text:var(--wp--custom--color--text--default);--ls-button-fill-duration:500ms;--ls-button-fill-enter-delay:80ms;--ls-button-active-scale:0.98;}"
            }
        }
    }
}
