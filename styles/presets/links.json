{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "elements": {
            "link": {
                "color": {
                    "text": "var:custom|color|link|accent"
                },
                ":hover": {
                    "color": {
                        "text": "var:custom|color|link|accent-hover"
                    },
					"typography": {

						"textDecoration": "none"

					}

                }
            }
        },
        "blocks": {
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "none"
                            }
                        }
                    }
                }
            }
        }
    }
}
