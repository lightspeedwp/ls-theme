{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/comment-author-name": {
                "color": {
                    "text": "var:custom|color|text|brand"
                },
                "spacing": {
                    "margin": {
                        "top": "var:preset|spacing|5",
                        "bottom": "0"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|200",
                    "fontWeight": "var:custom|typography|font-weight|semibold",
                    "lineHeight": "var:custom|line-height|paragraph"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:custom|color|text|brand"
                        },
                        "typography": {
                            "fontSize": "var:preset|font-size|200",
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                }
            }
        }
    }
}