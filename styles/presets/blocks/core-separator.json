{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/separator": {
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 1px 0"
                },
                "color": {
                    "text": "var(--wp--custom--color--border--card)"
                },
                "variations": {
                    "wide": {
                        "css": "&:not(.alignfull) { max-width: var(--wp--style--global--wide-size) !important; }"
                    }
                }
            }
        }
    }
}