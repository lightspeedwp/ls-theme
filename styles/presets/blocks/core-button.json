{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var:custom|color|button|outline|border",
                            "style": "solid",
                            "width": "2px",
                            "radius": "var:preset|border-radius|200"
                        },
                        "color": {
                            "background": "var:custom|color|surface|canvas",
                            "text": "var:custom|color|text|default"
                        },
                        "spacing": {
                            "padding": {
                                "top": "calc(1rem - 2px)",
                                "right": "var:custom|spacing|button|padding-right",
                                "bottom": "calc(1rem - 2px)",
                                "left": "var:custom|spacing|button|padding-left"
                            }
                        },
                        "typography": {
                            "fontSize": "var:preset|font-size|200",
                            "fontWeight": "var:custom|typography|font-weight|bold",
                            "letterSpacing": "0.08em"
                        }
                    }
                }
            }
        }
    }
}
