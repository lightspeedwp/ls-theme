{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var(--wp--custom--color--button--outline--border)",
                            "style": "solid",
                            "width": "2px",
                            "radius": "var:preset|border-radius|200"
                        },
                        "color": {
                            "background": "var(--wp--custom--color--surface--canvas)",
                            "text": "var(--wp--custom--color--text--default)"
                        },
                        "spacing": {
                            "padding": {
                                "top": "calc(var(--wp--custom--spacing--button--padding-top) - 2px)",
                                "right": "var(--wp--custom--spacing--button--padding-right)",
                                "bottom": "calc(var(--wp--custom--spacing--button--padding-bottom) - 2px)",
                                "left": "var(--wp--custom--spacing--button--padding-left)"
                            }
                        },
                        "typography": {
                            "fontSize": "var:preset|font-size|200",
                            "fontWeight": "700",
                            "letterSpacing": "0.08em"
                        },
                        "css": "&{--ls-button-outline-accent-background:var(--wp--custom--color--button--outline--border);--ls-button-outline-accent-colour:var(--wp--custom--color--button--outline--text-hover);--ls-button-outline-icon-radius:var(--wp--preset--border-radius--100);}"
                    }
                }
            }
        }
    }
}
