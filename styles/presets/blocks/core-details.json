{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/details": {
                "border": {
                    "color": "var(--wp--custom--color--border--card)",
                    "radius": "var:preset|border-radius|200",
                    "style": "solid",
                    "width": "1px"
                },
                "color": {
                    "background": "var(--wp--custom--color--surface--card)",
                    "text": "var(--wp--custom--color--text--default)"
                },
                "spacing": {
                    "blockGap": "0"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|heading",
                    "fontSize": "var:preset|font-size|300",
                    "fontWeight": "var:custom|typography|font-weight|light",
                    "letterSpacing": "0",
                    "lineHeight": "var:custom|line-height|paragraph"
                }
            }
        }
    }
}