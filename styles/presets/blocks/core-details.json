{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/details": {
                "border": {
                    "color": "var:custom|color|border|card",
                    "radius": "var:preset|border-radius|200",
                    "style": "solid",
                    "width": "1px"
                },
                "color": {
                    "background": "var:custom|color|surface|card",
                    "text": "var:custom|color|text|default"
                },
                "spacing": {
                    "blockGap": "0"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|heading",
                    "fontSize": "var:preset|font-size|300",
                    "fontWeight": "var:custom|typography|font-weight|light",
                    "letterSpacing": "0",
                    "lineHeight": "var:custom|line-height|paragraph"
                },
                "css": "&{overflow:hidden;}\n\n& > summary{display:flex;align-items:center;gap:var(--wp--preset--spacing--20);color:inherit;list-style:none;cursor:pointer;}\n\n& > summary::-webkit-details-marker{display:none;}\n\n& > summary::marker{content:'';}\n\n& > summary:focus{outline:none;}\n\n& > summary::after{content:'';display:block;flex:none;width:0.625rem;height:0.625rem;margin-inline-start:auto;border-right:2px solid var(--wp--custom--color--link--accent);border-bottom:2px solid var(--wp--custom--color--link--accent);transform-origin:center;}\n\n& > :where(:not(summary)){margin:0;padding-left:var(--wp--preset--spacing--30);padding-right:var(--wp--preset--spacing--30);}\n\n& > :where(:not(summary):first-of-type){padding-top:var(--wp--preset--spacing--20);}\n\n& > :where(:not(summary):last-child){padding-bottom:var(--wp--preset--spacing--20);}\n\n& > :where(:not(summary)) + :where(:not(summary)){padding-top:var(--wp--preset--spacing--20);}"
            }
        }
    }
}