{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/search": {
                "css": ".wp-block-search__button-inside .wp-block-search__inside-wrapper { border: none; }",
                "typography": {
                    "fontSize": "var:preset|font-size|300",
                    "lineHeight": "var:custom|line-height|paragraph"
                },
                "elements": {
                    "button": {
                        "color": {
                            "background": "transparent",
                            "text": "var:custom|color|text|default"
                        },
                        "border": {
                            "radius": "var:preset|border-radius|200"
                        }
                    }
                }
            }
        }
    }
}