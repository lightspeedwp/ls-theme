{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/comment-reply-link": {
                "typography": {
                    "fontSize": "var:preset|font-size|100",
                    "lineHeight": "var(--wp--custom--line-height--paragraph)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--custom--color--link--accent)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--custom--color--link--accent-hover)"
                            },
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                }
            }
        }
    }
}