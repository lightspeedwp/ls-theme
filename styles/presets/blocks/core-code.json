{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/code": {
                "border": {
                    "radius": "var:preset|border-radius|200",
                    "width": "0"
                },
                "color": {
                    "background": "var:custom|color|surface|card-raised",
                    "text": "var:custom|color|text|default"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|20",
                        "right": "var:preset|spacing|20",
                        "bottom": "var:preset|spacing|20",
                        "left": "var:preset|spacing|20"
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|monospace",
                    "fontSize": "var:preset|font-size|200",
                    "fontWeight": "var:custom|typography|font-weight|normal"
                }
            }
        }
    }
}