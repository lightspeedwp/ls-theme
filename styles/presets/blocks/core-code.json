{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/code": {
                "border": {
                    "radius": "var:preset|border-radius|200",
                    "width": "0"
                },
                "color": {
                    "background": "var(--wp--custom--color--surface--card-raised)",
                    "text": "var(--wp--custom--color--text--default)"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|20",
                        "right": "var:preset|spacing|20",
                        "bottom": "var:preset|spacing|20",
                        "left": "var:preset|spacing|20"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--monospace, monospace)",
                    "fontSize": "var:preset|font-size|200",
                    "fontWeight": "400"
                }
            }
        }
    }
}