{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/post-excerpt": {
                "color": {
                    "text": "var(--wp--custom--color--text--muted)"
                },
                "typography": {
                    "fontSize": "var:preset|font-size|200",
                    "lineHeight": "var(--wp--custom--line-height--paragraph)"
                },
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                }
            }
        }
    }
}