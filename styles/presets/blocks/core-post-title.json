{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "styles": {
        "blocks": {
            "core/post-title": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:custom|color|text|default"
                        },
                        "typography": {
                            "fontWeight": "var:custom|typography|font-weight|semibold",
                            "lineHeight": "var:custom|line-height|heading-default",
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var:custom|color|link|accent-hover"
                            },
                            "typography": {
                                "textDecoration": "none"
                            }
                        }
                    }
                }
            }
        }
    }
}