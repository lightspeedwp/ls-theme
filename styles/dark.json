{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"custom": {
			"color": {
				"text": {
					"default": "var(--wp--preset--color--base)",
					"inverse": "var(--wp--preset--color--contrast)",
					"muted": "var(--wp--preset--color--neutral-400)",
					"brand": "var(--wp--preset--color--cta-500)",
					"brand-strong": "var(--wp--preset--color--cta-200)"
				},
				"surface": {
					"canvas": "var(--wp--preset--color--contrast)",
					"card": "var(--wp--preset--color--neutral-900)",
					"card-raised": "var(--wp--preset--color--neutral-800)",
					"highlight": "var(--wp--preset--color--base)"
				},
				"border": {
					"card": "var(--wp--preset--color--neutral-800)"
				},
				"icon": {
					"background": "var(--wp--preset--color--cta-500)",
					"color": "var(--wp--preset--color--contrast)"
				},
				"card": {
					"solutions": {
						"brand": "var(--wp--preset--color--cta-500)",
						"accent": "var(--wp--preset--color--accent-three-500)"
					}
				},
				"text-shadow": {
					"contrast": "var(--wp--preset--color--base)",
					"base": "var(--wp--preset--color--contrast)"
				},
				"link": {
					"default": "var(--wp--preset--color--base)",
					"decoration-start": "var(--wp--preset--color--brand-400)",
					"decoration-end": "var(--wp--preset--color--accent-300)",
					"accent": "var(--wp--preset--color--cta-500)",
					"accent-hover": "var(--wp--preset--color--cta-300)"
				},
				"button": {
					"fill": {
						"background": "var(--wp--preset--color--cta-500)",
						"text": "var(--wp--preset--color--contrast)",
						"border": "var(--wp--preset--color--cta-500)",
						"background-hover": "var(--wp--preset--color--cta-400)",
						"text-hover": "var(--wp--preset--color--contrast)",
						"border-hover": "var(--wp--preset--color--cta-400)"
					},
					"outline": {
						"background": "var(--wp--preset--color--surface-400)",
						"text": "var(--wp--preset--color--cta-500)",
						"border": "var(--wp--preset--color--cta-500)",
						"background-hover": "var(--wp--preset--color--cta-400)",
						"text-hover": "var(--wp--preset--color--contrast)"
					}
				},
				"focus": {
					"ring": "var(--wp--preset--color--base)"
				},
				"effect": {
					"spotlight": {
						"primary": "var(--wp--preset--color--brand-500)",
						"secondary": "var(--wp--preset--color--accent-three-500)"
					},
					"hero": {
						"brand": "var(--wp--preset--color--brand-300)",
						"cta": "var(--wp--preset--color--cta-300)",
						"accent": "var(--wp--preset--color--accent-two-300)"
					}
				}
			},
			"shadow": {
				"elevation": {
					"100": "0.5px 2px 3px 0.5px rgba(8, 8, 8, 0.36)",
					"200": "0.5px 2px 6px 1px rgba(8, 8, 8, 0.38)",
					"300": "1px 4px 12px 4px rgba(8, 8, 8, 0.42)",
					"400": "1px 4px 12px 4px rgba(8, 8, 8, 0.48)",
					"500": "1px 4px 12px 4px rgba(8, 8, 8, 0.54)",
					"600": "2px 6px 12px 6px rgba(8, 8, 8, 0.6)"
				},
				"interactive": {
					"accent": "1px 4px 12px 4px color-mix(in srgb, var(--wp--custom--color--link--accent) 62%, transparent)"
				},
				"card": {
					"hover": "var(--wp--custom--shadow--elevation--400), 0 28px 56px -28px color-mix(in srgb, var(--wp--custom--color--link--accent) 52%, transparent), 0 14px 30px -18px color-mix(in srgb, var(--wp--custom--color--link--accent) 32%, transparent)"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--custom--color--surface--canvas)",
			"text": "var(--wp--custom--color--text--default)"
		}
	}
}
