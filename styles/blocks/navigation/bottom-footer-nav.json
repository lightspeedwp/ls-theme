{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Bottom Footer Nav",
	"slug": "bottom-footer-nav",
	"blockTypes": [
		"core/navigation"
	],
	"description": "Compact monospace legal navigation for the footer rights row.",
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|monospace",
			"fontSize": "var:preset|font-size|100",
			"fontWeight": "var:custom|typography|font-weight|normal",
			"lineHeight": "var:custom|line-height|paragraph"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:custom|color|text|muted"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"css": "&{--ls-bottom-footer-nav-separator-colour:color-mix(in srgb,var(--wp--custom--color--text--muted) 35%,transparent);--ls-bottom-footer-nav-item-opacity:0.72;}"
	}
}