{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Button Arrow Compact",
	"slug": "button-arrow-compact",
	"blockTypes": [
		"core/button"
	],
	"description": "Compact square button with the shared arrow glyph for card CTAs.",
	"styles": {
		"border": {
			"color": "var(--ls-button-arrow-compact-border-rest)",
			"radius": "var:preset|border-radius|100",
			"style": "solid",
			"width": "1px"
		},
		"color": {
			"background": "var(--ls-button-arrow-compact-background-rest)",
			"text": "var(--ls-button-arrow-compact-colour-rest)"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"css": "&{--ls-button-arrow-compact-size:2.5rem;--ls-button-arrow-compact-accent-colour:var(--ls-card-solutions-accent-colour,var(--wp--custom--color--card--solutions--brand));--ls-button-arrow-compact-border-rest:var(--ls-button-arrow-compact-accent-colour);--ls-button-arrow-compact-background-rest:color-mix(in srgb,var(--ls-button-arrow-compact-accent-colour) 10%,transparent);--ls-button-arrow-compact-background-active:var(--ls-button-arrow-compact-accent-colour);--ls-button-arrow-compact-colour-rest:var(--ls-button-arrow-compact-accent-colour);--ls-button-arrow-compact-colour-active:var(--wp--custom--color--button--fill--text);}"
	}
}