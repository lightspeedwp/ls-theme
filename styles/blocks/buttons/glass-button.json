{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Glass Button",
	"slug": "glass-button",
	"blockTypes": [
		"core/button"
	],
	"description": "Reusable frosted-glass button treatment with subtle lift and accent focus feedback. Shared interaction contract lives in src/scss/animations.scss.",
	"styles": {
		"border": {
			"color": "color-mix(in srgb, var(--wp--custom--color--surface--highlight) 35%, transparent)",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"color": {
			"background": "color-mix(in srgb, var(--wp--custom--color--surface--card) 24%, transparent)",
			"text": "var:custom|color|text|default"
		},
		"shadow": "var:preset|shadow|200",
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"right": "var:preset|spacing|40",
				"bottom": "var:preset|spacing|20",
				"left": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontSize": "var:preset|font-size|200",
			"fontWeight": "var:custom|typography|font-weight|semibold",
			"letterSpacing": "0.08em"
		},
		"css": "&{--ls-glass-button-blur:24px;--ls-glass-button-focus-width:2px;--ls-glass-button-focus-offset:4px;--ls-glass-button-lift:-2px;}"
	}
}
