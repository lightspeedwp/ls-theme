{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Button Glow Accent",
  "slug": "button-glow-accent",
  "blockTypes": [
    "core/button"
  ],
  "description": "Outlined accent button with a glow bloom on hover.",
  "styles": {
    "border": {
      "color": "var:preset|color|brand-500",
      "radius": "var:preset|border-radius|100",
      "style": "solid",
      "width": "2px"
    },
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|brand-500"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|20",
        "right": "var:preset|spacing|40",
        "bottom": "var:preset|spacing|20",
        "left": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontSize": "var:preset|font-size|200",
      "fontWeight": "600",
      "letterSpacing": "0.08em"
    },
    "css": "&{--ls-button-glow-colour:var(--wp--preset--color--brand-500);--ls-button-glow-hover-background:var(--wp--preset--color--brand-500);--ls-button-glow-hover-text:var(--wp--preset--color--base);--ls-button-glow-enter-delay:80ms;--ls-button-glow-outline-width:1px;--ls-button-glow-outline-offset:12px;--ls-button-glow-resting-strength:0%;--ls-button-glow-outline-strength:45%;--ls-button-glow-inner-strength:35%;--ls-button-glow-outer-strength:20%;--ls-button-active-scale:0.98;}"
  }
}
