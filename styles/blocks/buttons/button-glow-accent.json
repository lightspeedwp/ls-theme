{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Button Glow Accent",
  "slug": "button-glow-accent",
  "blockTypes": [
    "core/button"
  ],
  "description": "Outlined accent button with a glow bloom on hover. Shared interaction contract lives in src/scss/animations.scss.",
  "styles": {
    "border": {
      "color": "var:custom|color|button|outline|border",
      "radius": "var:preset|border-radius|100",
      "style": "solid",
      "width": "2px"
    },
    "color": {
      "background": "var:custom|color|button|outline|background",
      "text": "var:custom|color|button|outline|text"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|20",
        "right": "var:preset|spacing|40",
        "bottom": "var:preset|spacing|20",
        "left": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontSize": "var:preset|font-size|200",
      "fontWeight": "600",
      "letterSpacing": "0.08em"
    }
  }
}
