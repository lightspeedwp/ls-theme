{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Button Dot Accent",
  "slug": "button-dot-accent",
  "blockTypes": [
    "core/button"
  ],
  "description": "Visible pill button with an accent dot that wraps the right-hand arrow on hover.",
  "styles": {
    "color": {
      "text": "var:preset|color|base"
    },
    "border": {
      "radius": "999px"
    },
    "spacing": {
      "padding": {
        "top": "0.9rem",
        "right": "4rem",
        "bottom": "0.9rem",
        "left": "1.25rem"
      }
    },
    "typography": {
      "fontSize": "var:preset|font-size|small",
      "fontWeight": "700",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "css": "&{--ls-button-dot-fill: var(--wp--preset--color--accent); --ls-button-dot-text: var(--wp--preset--color--base); --ls-button-dot-hover-text: var(--wp--preset--color--contrast); --ls-button-dot-icon-color: var(--wp--preset--color--base); --ls-button-dot-circle-size: 2.5rem; --ls-button-dot-duration: 500ms;}"
  }
}
