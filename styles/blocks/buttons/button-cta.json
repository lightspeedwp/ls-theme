{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Button CTA",
  "slug": "button-cta",
  "blockTypes": [
    "core/button"
  ],
  "description": "CTA button with a strong resting glow that blooms further on hover.",
  "styles": {
    "border": {
      "color": "var(--wp--custom--color--action--primary--border)",
      "radius": "var:preset|border-radius|100",
      "style": "solid",
      "width": "2px"
    },
    "color": {
      "background": "var(--wp--custom--color--action--primary--background)",
      "text": "var(--wp--custom--color--action--primary--text)"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|30",
        "right": "var:preset|spacing|50",
        "bottom": "var:preset|spacing|30",
        "left": "var:preset|spacing|50"
      }
    },
    "typography": {
      "fontSize": "var:preset|font-size|200",
      "fontWeight": "600",
      "lineHeight": "var(--wp--custom--line-height--button)"
    },
    "css": "&{--ls-button-glow-colour:var(--wp--custom--color--action--primary--background);--ls-button-hover-background:var(--wp--custom--color--action--primary--background-hover);--ls-button-hover-text:var(--wp--custom--color--action--primary--text-hover);--ls-button-hover-border:var(--wp--custom--color--action--primary--border-hover);--ls-button-glow-enter-delay:80ms;--ls-button-glow-outline-offset:12px;--ls-button-glow-size:28px;--ls-button-glow-resting-size:24px;--ls-button-glow-resting-strength:100%;--ls-button-glow-resting-outer-strength:100%;--ls-button-glow-inner-strength:74%;--ls-button-glow-outer-strength:56%;--ls-button-glow-halo-strength:34%;--ls-button-active-scale:0.98;}"
  }
}