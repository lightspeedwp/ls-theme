{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Link Arrow Accent",
	"slug": "link-arrow-accent",
	"blockTypes": [
		"core/read-more"
	],
	"description": "Read-more links with an inline arrow accent for compact card CTAs.",
	"styles": {
		"spacing": {
			"margin": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"typography": {
			"fontSize": "var:preset|font-size|200"
		},
		"css": "&{--ls-link-arrow-gap:0.45ch;--ls-link-arrow-offset:0.35em;--ls-link-arrow-hover-colour:var(--wp--custom--color--link--accent-hover);}"
	}
}
