{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Link Underline Accent",
  "slug": "link-underline-accent",
  "blockTypes": [
    "core/paragraph"
  ],
  "description": "Paragraph links with an accent underline that draws on hover.",
  "styles": {
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--custom--color--link--default)"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    },
    "css": "&{--ls-link-underline-image:linear-gradient(var(--wp--custom--color--link--decoration-start),var(--wp--custom--color--link--decoration-end));--ls-link-underline-padding-bottom:5px;--ls-link-underline-thickness:2px;--ls-link-underline-enter-delay:80ms;}"
  }
}
