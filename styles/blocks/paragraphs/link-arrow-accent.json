{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Link Arrow Accent",
	"slug": "link-arrow-accent",
	"blockTypes": [
		"core/paragraph"
	],
	"description": "Paragraph links with an inline arrow accent for compact card CTAs.",
	"styles": {
		"elements": {
			"link": {
				"color": {
					"text": "var:custom|color|link|accent"
				},
				"typography": {
					"fontWeight": "var:custom|typography|font-weight|semibold",
					"textDecoration": "none"
				}
			}
		},
		"css": "&{--ls-link-arrow-gap:0.45ch;--ls-link-arrow-offset:0.35em;--ls-link-arrow-hover-colour:var(--wp--custom--color--link--accent-hover);}"
	}
}
