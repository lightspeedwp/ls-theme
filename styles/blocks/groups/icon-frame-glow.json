{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Icon Frame Glow",
	"slug": "icon-frame-glow",
	"blockTypes": [
		"core/group"
	],
	"description": "Compact icon frame with a reusable accent glow treatment.",
	"styles": {
		"color": {
			"background": "var(--ls-icon-frame-background-rest)",
			"text": "var(--ls-icon-frame-accent-colour)"
		},
		"border": {
			"color": "var(--ls-icon-frame-border-rest)",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"right": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20",
				"left": "var:preset|spacing|20"
			}
		},
		"css": "&{--ls-icon-frame-accent-colour:var(--ls-card-solutions-accent-colour,var(--wp--custom--color--card--solutions--brand));--ls-icon-frame-border-rest:var(--ls-icon-frame-accent-colour);--ls-icon-frame-background-rest:color-mix(in srgb,var(--ls-icon-frame-accent-colour) 10%,transparent);}"
	}
}