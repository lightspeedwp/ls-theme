{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Icon Frame Brand CTA",
	"slug": "icon-frame-brand-cta",
	"blockTypes": [
		"core/group"
	],
	"description": "Static icon frame with preset padding only, a slight brand-to-CTA gradient, and inverse icon colour. Shared runtime contract lives in src/scss/animations.scss.",
	"styles": {
		"color": {
			"text": "var:custom|color|text|inverse"
		},
		"border": {
			"color": "color-mix(in srgb, var(--ls-icon-frame-brand-cta-start) 24%, var(--ls-icon-frame-brand-cta-end) 24%, transparent)",
			"radius": "var:preset|border-radius|200",
			"style": "solid",
			"width": "1px"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|20",
				"right": "var:preset|spacing|20",
				"bottom": "var:preset|spacing|20",
				"left": "var:preset|spacing|20"
			}
		},
		"css": "&{--ls-icon-frame-brand-cta-start:var(--wp--custom--color--surface--brand);--ls-icon-frame-brand-cta-end:var(--wp--custom--color--surface--cta);}"
	}
}
