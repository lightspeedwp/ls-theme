{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Gradient Accent",
  "slug": "gradient-accent",
  "blockTypes": [
    "core/heading"
  ],
  "description": "Animated gradient text for headings using the LightSpeed Theme accent presets. Shared interaction contract lives in src/scss/animations.scss.",
  "styles": {
    "color": {
      "text": "var:custom|color|text|brand"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:custom|color|text|brand"
        }
      }
    },
    "css": "&{--ls-accent-gradient-image:linear-gradient(to right,var(--wp--custom--color--text--brand) 0%,var(--wp--custom--color--text--default) 25%,var(--wp--custom--color--text--brand-strong) 50%,var(--wp--custom--color--text--default) 75%,var(--wp--custom--color--text--brand) 100%);}"
  }
}
